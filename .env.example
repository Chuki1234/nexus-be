# Sao chép thành `.env` rồi điền giá trị thật. `.env` đã nằm trong .gitignore.
#
# Lấy ở Supabase Dashboard → Project Settings → API.
# Không có dấu `/` ở cuối: supabase-js tự nối đường dẫn, thừa dấu này thành `//rest/v1`.
SUPABASE_URL=https://ubdgjtjxcytwctsbtpjy.supabase.co

# CẢNH BÁO: service_role key bỏ qua toàn bộ Row Level Security.
# Chỉ để ở backend. Không đưa vào nexus-fe, không commit, không log.
SUPABASE_SERVICE_ROLE_KEY=

# Khoá công khai (publishable/anon) — chính là khoá nexus-fe đang dùng.
# Backend dùng nó cho lời gọi đăng nhập thay mặt người dùng, để không mất
# rate limit và bảo vệ brute-force sẵn có của Supabase.
SUPABASE_ANON_KEY=

# Origin của frontend được phép gọi API. Nhiều origin thì ngăn cách bằng dấu phẩy.
# Là origin thuần, không kèm đường dẫn và không có `/` ở cuối — trình duyệt gửi
# header `Origin: http://localhost:4200`, thừa một ký tự là CORS không khớp.
CORS_ORIGINS=http://localhost:4200

PORT=3000

# Lấy ở giphy.com/dashboard. Backend proxy /api/giphy/* dùng khoá này — FE không
# tự gọi GIPHY nữa (từ PR#13), nên không cần đặt khoá này ở nexus-fe.
GIPHY_API_KEY=

# ==============================================================================
# REDIS CLUSTER / DISTRIBUTED REALTIME CONFIGURATION
# ==============================================================================
# Khi chạy nhiều backend instance phân tán trên các máy dev hoặc production:
# REALTIME_DISTRIBUTED=true (Bắt buộc kết nối Redis, fail-fast nếu thiếu)
REALTIME_DISTRIBUTED=false

# URL kết nối Redis:
# - Local (Docker / WSL / native): redis://127.0.0.1:6379
# - Remote (Upstash / Redis Cloud / self-hosted): redis://default:<password>@<host>:<port>
REDIS_URL=redis://127.0.0.1:6379

# Tiền tố key phân tách môi trường (tránh va chạm giữa dev/test/staging):
REDIS_KEY_PREFIX=nexuscord:dev:

# Định danh instance (tùy chọn, mặc định tự sinh từ hostname + PID + UUID):
# INSTANCE_ID=instance-dev-1
