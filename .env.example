# Sao chép thành `.env` rồi điền giá trị thật. `.env` đã nằm trong .gitignore.
#
# Lấy ở Supabase Dashboard → Project Settings → API.
# Không có dấu `/` ở cuối: supabase-js tự nối đường dẫn, thừa dấu này thành `//rest/v1`.
SUPABASE_URL=https://ubdgjtjxcytwctsbtpjy.supabase.co

# CẢNH BÁO: service_role key bỏ qua toàn bộ Row Level Security.
# Chỉ để ở backend. Không đưa vào nexus-fe, không commit, không log.
SUPABASE_SERVICE_ROLE_KEY=

# Khoá công khai, giống hệt khoá trong nexus-fe/src/environments/environment.ts.
# Backend hiện chưa dùng tới (mọi thao tác đều đi bằng service_role); giữ ở đây để
# hai bên cùng trỏ về một project khi cần đối chiếu.
SUPABASE_ANON_KEY=sb_publishable_HueUJF-kVoMvvjfAFup-Ng_AJUV3J7l

# Kết nối MongoDB Atlas cho module `drink` (bài tập Quầy Trà Sữa).
# Lấy ở Atlas → Cluster → Connect → Drivers, rồi thay <user>/<pass>/<cluster>.
#
# Tên database nằm ngay trước dấu `?` — để là `bai-tap-tra-sua`, KHÔNG dùng chung
# database với dữ liệu thật: làm sai ở bài tập thì không đụng tới dữ liệu thật.
# Mật khẩu có ký tự đặc biệt (@ : / ?) phải percent-encode, nếu không URI bị cắt sai chỗ.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/bai-tap-tra-sua?retryWrites=true&w=majority

# Origin của frontend được phép gọi API. Nhiều origin thì ngăn cách bằng dấu phẩy.
# Là origin thuần, không kèm đường dẫn và không có `/` ở cuối — trình duyệt gửi
# header `Origin: http://localhost:4200`, thừa một ký tự là CORS không khớp.
CORS_ORIGINS=http://localhost:4200

PORT=3000
